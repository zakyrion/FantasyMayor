<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="HexInfoPanel.uss" />
    <!-- Sample header text and the two chips are EDITOR-PREVIEW ONLY (so the panel reads correctly in UI
         Builder). At runtime SetHeader overwrites the header and the resources system clears + rebuilds the
         chips (HexInfoPanelView strips these sample chips on first cache). -->
    <ui:VisualElement name="Root" class="raycast-transparent" style="flex-grow: 1;">
        <ui:VisualElement name="HexInfoPanelView" class="info-panel">
            <ui:VisualElement name="AccentLine" class="accent-line" />
            <ui:VisualElement name="Header" class="header">
                <ui:VisualElement name="HeaderIcon" class="terrain-icon" />
                <ui:VisualElement name="HeaderTitles" class="header-titles">
                    <ui:Label name="HeaderTitle" text="Лісисті пагорби" class="title" />
                    <ui:Label name="HeaderCoord" text="Hex · 3, 0" class="coord" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ResourcesSection" class="section">
                <ui:Label text="РЕСУРСИ ГЕКСУ" class="section-label" />
                <ui:VisualElement name="ResourcesContainer" class="chips">
                    <ui:VisualElement class="chip">
                        <ui:VisualElement class="chip-icon" />
                        <ui:Label text="Ліс" class="chip-label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="chip">
                        <ui:VisualElement class="chip-icon" />
                        <ui:Label text="Глина" class="chip-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="DistrictSection" class="section">
                <ui:Label text="РАЙОН" class="section-label" />
                <ui:Label text="Поки недоступно" class="district-placeholder" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- End Turn button — a sibling of the info-panel card inside the same shared Root. Label is authored
             uppercase (USS has no text-transform) and is overwritten at runtime by EndTurnView.SetProcessing.
             EndTurnView toggles this button's own display (Show/Hide), never the document root. -->
        <ui:Button name="EndTurnButton" text="ЗАВЕРШИТИ ХІД" class="end-turn-button" />
    </ui:VisualElement>
</ui:UXML>
