/* Bottom panel — tokens from GENERAL_UI_STYLE.md §6, USS-safe per §11 (no box-shadow / ::before / blur / gradient).
   ONE full-width shell (§4): left TURN sub-panel (state + End Turn) | right CONTEXT sub-panel (selected hex),
   split by a vertical divider. The shell previews VISIBLE in UI Builder; at runtime it spawns hidden and
   EndTurnView reveals it on Gameplay, while HexInfoPanelView swaps ContextFilled <-> ContextEmpty.
   Sizes are scaled +50% from the mockup base (design-mockups/FantasyMayor-HUD.html): every px is the mockup value x1.5. */

/* ============ SHELL ============ */
.bottom-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    /* Flush to the screen's bottom + side edges (no margins) and fully opaque (no transparency). */
    background-color: rgb(24, 20, 16);
    /* Only the top edge floats, so only it carries the gold rim; all four corners are squared (no radius).
       The other three sides sit at the screen edge and are border-less. */
    border-top-width: 3px;
    border-top-color: rgba(232, 184, 90, 0.65);
    overflow: hidden;
}

/* Gold top-accent line (a real element — USS has no ::before). */
.accent-line {
    height: 5px;
    background-color: rgb(217, 164, 65);
}

.bp-row {
    flex-direction: row;
    align-items: stretch;
}

/* ============ TURN sub-panel (left) ============ */
.bp-turn {
    width: 315px;
    flex-shrink: 0;
    flex-direction: column;
    padding-top: 21px;
    padding-bottom: 21px;
    padding-left: 24px;
    padding-right: 24px;
    border-right-width: 1px;
    border-right-color: rgba(217, 164, 65, 0.14);
}

.turn-number {
    font-size: 33px;
    margin-top: 0;
    color: rgb(224, 178, 90);
    -unity-font-style: bold;
}

/* AP — TWO tiles (Дії зараз / наст. хід), mockup .ap/.tile scaled to the panel's established density.
   VISIBLE placeholders (dashes) until the AP model lands. flex-grow shares the row; a right margin on the
   first tile fakes the inter-tile gap (USS flex `gap` is version-fragile, so we use a margin). */
.turn-ap {
    flex-direction: row;
    margin-top: 24px;
}

.turn-ap-tile {
    flex-grow: 1;
    flex-basis: 0;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.turn-ap-tile--cur {
    margin-right: 12px;
    background-color: rgba(255, 255, 255, 0.045);
    border-left-color: rgba(217, 164, 65, 0.2);
    border-right-color: rgba(217, 164, 65, 0.2);
    border-top-color: rgba(217, 164, 65, 0.2);
    border-bottom-color: rgba(217, 164, 65, 0.2);
}

.turn-ap-tile--nxt {
    background-color: rgba(255, 255, 255, 0.03);
    border-left-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
}

.turn-ap-tile-cap {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(125, 114, 100);
}

.turn-ap-tile-num {
    font-size: 39px;
    margin-top: 6px;
    -unity-font-style: bold;
}

.turn-ap-tile-num--cur {
    color: rgb(224, 178, 90);
}

.turn-ap-tile-num--nxt {
    color: rgba(217, 164, 65, 0.85);
}

/* End Turn button — the hero CTA, the one filled-gold button (§9 exception). Pinned to the sub-panel bottom
   with margin-top: auto so the two sub-panels share a common bottom edge. Glow/elevation come from a 9-slice
   sprite in-engine; USS has no box-shadow / gradient (§11). A lighter border-top fakes a bevel. */
.end-turn-button {
    margin-top: auto;
    width: 100%;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 22px;
    padding-right: 22px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 18px;
    letter-spacing: 2px;
    color: rgb(37, 28, 14);
    background-color: rgb(217, 164, 65);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(185, 138, 53);
    border-right-color: rgb(185, 138, 53);
    border-bottom-color: rgb(185, 138, 53);
    border-top-color: rgba(255, 255, 255, 0.4);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.end-turn-button:hover {
    background-color: rgb(232, 192, 116);
}

/* Processing — non-interactive, dimmed gold; mirrors the engine re-entry guard. */
.end-turn-button.is-processing {
    color: rgb(224, 178, 90);
    background-color: rgba(217, 164, 65, 0.14);
    border-left-color: rgba(224, 178, 90, 0.32);
    border-right-color: rgba(224, 178, 90, 0.32);
    border-top-color: rgba(224, 178, 90, 0.32);
    border-bottom-color: rgba(224, 178, 90, 0.32);
}

/* ============ CONTEXT sub-panel (right) ============ */
.bp-ctx {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

.ctx-filled {
    flex-grow: 1;
    flex-direction: column;
}

/* Tab row (Огляд / Будівлі / Дії) — ContextTabs window. A single-select toggle group; see .ctx-tab below. */
.ctx-tabs {
    flex-direction: row;
    padding-top: 10px;
    padding-left: 24px;
    padding-right: 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(217, 164, 65, 0.14);
}

/* Hex identity (icon + name) — relocated from the old header into the overview body (mockup .hexhead). */
.hexhead {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
}

.terrain-icon {
    width: 51px;
    height: 51px;
    margin-right: 15px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(255, 255, 255, 0.10);
}

.ctx-title {
    font-size: 23px;
    color: rgb(241, 231, 214);
    -unity-font-style: bold;
}

/* Tabs are ui:Toggle elements styled as a tab strip: the native checkmark and (empty) field label are hidden,
   so only the tab text shows. The active tab is shown via :checked — ContextTabsView drives each toggle's value
   from ActiveContextTabComponent. A transparent base underline reserves the 2px so the row never jumps. */
.ctx-tab {
    margin-right: 6px;
    margin-left: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.ctx-tab .unity-toggle__checkmark {
    display: none;
}

.ctx-tab .unity-base-field__label {
    display: none;
}

.ctx-tab .unity-toggle__input {
    margin-left: 0;
    margin-right: 0;
}

/* The visible tab caption is the Toggle's own text element — colour it directly (the default theme sets a
   colour on text elements, so an inherited colour on the toggle root would not win). */
.ctx-tab .unity-toggle__text {
    margin-left: 0;
    margin-right: 0;
    font-size: 18px;
    color: rgb(168, 156, 138);
}

.ctx-tab:checked {
    border-bottom-color: rgb(224, 178, 90);
}

.ctx-tab:checked .unity-toggle__text {
    color: rgb(241, 231, 214);
}

.ctx-body {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
}

.ctx-a {
    flex-grow: 1;
    min-width: 0;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 24px;
    padding-right: 24px;
}

.ctx-b {
    width: 345px;
    flex-shrink: 0;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 24px;
    padding-right: 24px;
    border-left-width: 1px;
    border-left-color: rgba(217, 164, 65, 0.14);
}

.section {
    margin-bottom: 18px;
}

.section-label {
    font-size: 16px;
    letter-spacing: 2px;
    margin-bottom: 14px;
    color: rgb(125, 114, 100);
}

/* ---- chips ---- */
.chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.chip {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
    margin-bottom: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 16px;
    background-color: rgba(255, 255, 255, 0.05);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
}

.chip-icon {
    width: 30px;
    height: 30px;
    margin-right: 11px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.10);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.chip-label {
    font-size: 20px;
    color: rgb(241, 231, 214);
}

/* ---- key-value grid (District scaffold) ---- */
.kvgrid {
    flex-direction: row;
    flex-wrap: wrap;
}

.kvcol {
    min-width: 192px;
    margin-right: 33px;
}

.kv {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
}

.kv-k {
    font-size: 18px;
    color: rgb(168, 156, 138);
}

.kv-v {
    font-size: 18px;
    color: rgb(241, 231, 214);
    -unity-font-style: bold;
}

.kv-v--warn {
    color: rgb(232, 169, 106);
}

.kv-v--city {
    color: rgb(127, 176, 214);
}

.kv-v--oper {
    color: rgb(158, 199, 138);
}

/* ---- yield split-bar (Yield scaffold) ---- */
.split-bar {
    flex-direction: row;
    height: 14px;
    margin-bottom: 16px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    overflow: hidden;
}

.split-seg {
    height: 100%;
}

.split-seg--city {
    background-color: rgb(91, 139, 176);
}

.split-seg--owner {
    background-color: rgb(224, 178, 90);
}

.split-seg--oper {
    background-color: rgb(111, 160, 91);
}

.scaffold-tag {
    font-size: 15px;
    margin-top: 12px;
    color: rgb(125, 114, 100);
    -unity-font-style: italic;
}

/* ============ CONTEXT empty state (nothing selected) ============ */
/* Intentionally blank — no tabs, no hint text. The container only exists as the swap target. */
.ctx-empty-wrap {
    flex-grow: 1;
}
