/* Hex info panel — tokens from GENERAL_UI_STYLE.md §4, USS-safe per §9 (no box-shadow/::before/blur).
   The panel is VISIBLE by default so it previews in UI Builder; at runtime HexInfoPanelSpawnSystem hides it
   until a hex is selected (HexInfoPanelView.Show/Hide toggle inline display). Icon slots use a placeholder
   background so the panel reads correctly before terrain/resource sprites are authored.
   Sizes are scaled +50% from the base design (width 320 → 480, fonts/padding/icons ×1.5). */

.info-panel {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 480px;
    max-height: 70%;
    background-color: rgba(24, 20, 16, 0.98);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    /* Faux-gradient bevel: native per-side border colors (no USS gradient / no sprite). Brighter gold on the
       top/left edges, dimmer on bottom/right — reads as a gold rim lit from the top-left. */
    border-top-color: rgba(232, 184, 90, 0.65);
    border-left-color: rgba(224, 178, 90, 0.45);
    border-right-color: rgba(217, 164, 65, 0.22);
    border-bottom-color: rgba(184, 140, 60, 0.20);
    border-top-left-radius: 21px;
    border-top-right-radius: 21px;
    border-bottom-left-radius: 21px;
    border-bottom-right-radius: 21px;
    overflow: hidden;
}

/* Gold top-accent line (a real element — USS has no ::before). */
.accent-line {
    height: 5px;
    background-color: rgb(217, 164, 65);
}

.header {
    flex-direction: row;
    align-items: center;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 27px;
    padding-right: 27px;
}

.terrain-icon {
    width: 84px;
    height: 84px;
    margin-right: 21px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(255, 255, 255, 0.10);
}

.header-titles {
    flex-direction: column;
}

.title {
    font-size: 30px;
    color: rgb(241, 231, 214);
    -unity-font-style: bold;
}

.coord {
    font-size: 18px;
    margin-top: 5px;
    color: rgb(168, 156, 138);
}

.section {
    padding-top: 21px;
    padding-bottom: 21px;
    padding-left: 27px;
    padding-right: 27px;
    border-top-width: 1px;
    border-top-color: rgba(217, 164, 65, 0.14);
}

.section-label {
    font-size: 17px;
    letter-spacing: 2px;
    margin-bottom: 15px;
    color: rgb(212, 180, 120);
}

.chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.chip {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
    margin-bottom: 12px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 12px;
    padding-right: 16px;
    background-color: rgba(255, 255, 255, 0.05);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
    border-top-left-radius: 21px;
    border-top-right-radius: 21px;
    border-bottom-left-radius: 21px;
    border-bottom-right-radius: 21px;
}

.chip-icon {
    width: 33px;
    height: 33px;
    margin-right: 11px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.10);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.chip-label {
    font-size: 20px;
    color: rgb(241, 231, 214);
}

.district-placeholder {
    font-size: 20px;
    color: rgb(168, 154, 134);
}

/* Bottom-left turn cluster card — same chrome as the info-panel card (panel-bg + faux-gradient gold rim).
   Holds "Хід N", the "Дії" placeholder, and the End Turn button. Sized +50% from the design like the panel. */
.turn-cluster {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 360px;
    background-color: rgba(24, 20, 16, 0.98);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-top-color: rgba(232, 184, 90, 0.65);
    border-left-color: rgba(224, 178, 90, 0.45);
    border-right-color: rgba(217, 164, 65, 0.22);
    border-bottom-color: rgba(184, 140, 60, 0.20);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 21px;
    padding-right: 21px;
}

.turn-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.turn-number {
    font-size: 26px;
    color: rgb(241, 231, 214);
    -unity-font-style: bold;
}

/* "Дії" (action points) — VISIBLE placeholder; dashes until the AP model lands. */
.turn-ap {
    flex-direction: row;
    align-items: center;
    margin-bottom: 15px;
}

.turn-ap-cap {
    font-size: 16px;
    letter-spacing: 1.5px;
    color: rgb(212, 180, 120);
    margin-right: 12px;
}

.turn-ap-cur {
    font-size: 27px;
    color: rgb(217, 164, 65);
    -unity-font-style: bold;
    margin-right: 9px;
}

.turn-ap-arrow {
    font-size: 18px;
    color: rgb(168, 156, 138);
    margin-right: 9px;
}

.turn-ap-nxt {
    font-size: 21px;
    color: rgba(217, 164, 65, 0.82);
    margin-right: 6px;
}

.turn-ap-nxt-cap {
    font-size: 14px;
    color: rgb(168, 156, 138);
}

/* End Turn button — the hero CTA, the one filled-gold button (GENERAL_UI_STYLE.md §7 exception). Glow/elevation
   come from a 9-slice sprite in-engine; USS has no box-shadow / gradient (§9). A lighter border-top fakes a
   bevel. Full-width inside the cluster card. */
.end-turn-button {
    width: 100%;
    padding: 14px 22px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    letter-spacing: 1.4px;
    color: rgb(37, 28, 14);
    background-color: rgb(217, 164, 65);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(185, 138, 53);
    border-right-color: rgb(185, 138, 53);
    border-bottom-color: rgb(185, 138, 53);
    border-top-color: rgba(255, 255, 255, 0.4);
    border-radius: 13px;
}

.end-turn-button:hover {
    background-color: rgb(232, 192, 116);
}

/* Processing — non-interactive, dimmed gold; mirrors the engine re-entry guard. */
.end-turn-button.is-processing {
    color: rgb(224, 178, 90);
    background-color: rgba(217, 164, 65, 0.14);
    border-left-color: rgba(224, 178, 90, 0.32);
    border-right-color: rgba(224, 178, 90, 0.32);
    border-top-color: rgba(224, 178, 90, 0.32);
    border-bottom-color: rgba(224, 178, 90, 0.32);
}
