/* Bottom panel — tokens from GENERAL_UI_STYLE.md §6, USS-safe per §11 (no box-shadow / ::before / blur / gradient).
   ONE full-width FIXED-HEIGHT shell (§4): left TURN sub-panel (state + End Turn) | right CONTEXT sub-panel
   (selected hex), split by a vertical divider. The shell previews VISIBLE in UI Builder; at runtime it spawns
   hidden and EndTurnView reveals it on Gameplay. CONTEXT: a PERMANENT tab row on top, then a filled/empty swap
   (HexInfoPanelView), and inside the filled state one of three tab panes (ContextTabsView).
   HUD HEIGHT BUDGET: the permanent VERTICAL HUD (thin top bar + bottom panel) stays within ~30% of screen
   height. @ reference 1080 (PanelSettings ScaleMode = Scale-With-Screen, match = height) px is a stable
   fraction of screen height: bottom-panel 280 (~25.9%) + top-bar 30 (~2.8%) ≈ 29%. RESOURCES no longer live
   in the top bar — they moved to a permanent LEFT-edge vertical scroll panel (.left-panel), so the top bar is
   now a thin empty strip (placeholder for future window-openers + system icons). The left panel eats map
   WIDTH, not height, so it is outside the vertical budget. */

/* ============ SHELL ============ */
.bottom-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    /* Fixed height (~25.9% of 1080) so the panel never grows upward with content; overflow is clipped. */
    height: 280px;
    /* Flush to the screen's bottom + side edges (no margins) and fully opaque (no transparency). */
    background-color: rgb(24, 20, 16);
    /* Only the top edge floats, so only it carries the gold rim; all four corners are squared (no radius).
       The other three sides sit at the screen edge and are border-less. */
    border-top-width: 2px;
    border-top-color: rgba(232, 184, 90, 0.65);
    overflow: hidden;
}

/* Gold top-accent line (a real element — USS has no ::before). */
.accent-line {
    height: 3px;
    background-color: rgb(217, 164, 65);
}

/* The two sub-panels fill the fixed shell height (flex-grow), stretched to a common height. */
.bp-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    min-height: 0;
}

/* ============ TURN sub-panel (left) ============ */
.bp-turn {
    width: 210px;
    flex-shrink: 0;
    flex-direction: column;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    border-right-width: 1px;
    border-right-color: rgba(217, 164, 65, 0.14);
}

.turn-number {
    font-size: 20px;
    margin-top: 0;
    color: rgb(224, 178, 90);
    -unity-font-style: bold;
}

/* AP — TWO tiles (Дії зараз / наст. хід), mockup .ap/.tile scaled to the panel's established density.
   VISIBLE placeholders (dashes) until the AP model lands. flex-grow shares the row; a right margin on the
   first tile fakes the inter-tile gap (USS flex `gap` is version-fragile, so we use a margin). */
.turn-ap {
    flex-direction: row;
    margin-top: 12px;
}

.turn-ap-tile {
    flex-grow: 1;
    flex-basis: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.turn-ap-tile--cur {
    margin-right: 7px;
    background-color: rgba(255, 255, 255, 0.045);
    border-left-color: rgba(217, 164, 65, 0.2);
    border-right-color: rgba(217, 164, 65, 0.2);
    border-top-color: rgba(217, 164, 65, 0.2);
    border-bottom-color: rgba(217, 164, 65, 0.2);
}

.turn-ap-tile--nxt {
    background-color: rgba(255, 255, 255, 0.03);
    border-left-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
}

.turn-ap-tile-cap {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(125, 114, 100);
}

.turn-ap-tile-num {
    font-size: 22px;
    margin-top: 3px;
    -unity-font-style: bold;
}

.turn-ap-tile-num--cur {
    color: rgb(224, 178, 90);
}

.turn-ap-tile-num--nxt {
    color: rgba(217, 164, 65, 0.85);
}

/* End Turn button — the hero CTA, the one filled-gold button (§9 exception). Pinned to the sub-panel bottom
   with margin-top: auto so the two sub-panels share a common bottom edge. Glow/elevation come from a 9-slice
   sprite in-engine; USS has no box-shadow / gradient (§11). A lighter border-top fakes a bevel. */
.end-turn-button {
    margin-top: auto;
    width: 100%;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 14px;
    padding-right: 14px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    letter-spacing: 2px;
    color: rgb(37, 28, 14);
    background-color: rgb(217, 164, 65);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(185, 138, 53);
    border-right-color: rgb(185, 138, 53);
    border-bottom-color: rgb(185, 138, 53);
    border-top-color: rgba(255, 255, 255, 0.4);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.end-turn-button:hover {
    background-color: rgb(232, 192, 116);
}

/* Processing — non-interactive, dimmed gold; mirrors the engine re-entry guard. */
.end-turn-button.is-processing {
    color: rgb(224, 178, 90);
    background-color: rgba(217, 164, 65, 0.14);
    border-left-color: rgba(224, 178, 90, 0.32);
    border-right-color: rgba(224, 178, 90, 0.32);
    border-top-color: rgba(224, 178, 90, 0.32);
    border-bottom-color: rgba(224, 178, 90, 0.32);
}

/* ============ CONTEXT sub-panel (right) ============ */
.bp-ctx {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

/* Tab row (Огляд / Будівлі / Дії) — ContextTabs window. PERMANENT (flex-shrink:0): never collapses and stays
   above the filled/empty swap. A single-select toggle group; see .ctx-tab below. */
.ctx-tabs {
    flex-direction: row;
    flex-shrink: 0;
    padding-top: 8px;
    padding-left: 16px;
    padding-right: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(217, 164, 65, 0.14);
}

/* Tabs are ui:Toggle elements styled as a tab strip: the native checkmark and (empty) field label are hidden,
   so only the tab text shows. The active tab is shown via :checked — ContextTabsView drives each toggle's value
   from ActiveContextTabComponent. A transparent base underline reserves the 2px so the row never jumps. */
.ctx-tab {
    margin-right: 4px;
    margin-left: 0;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 9px;
    padding-right: 9px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.ctx-tab .unity-toggle__checkmark {
    display: none;
}

.ctx-tab .unity-base-field__label {
    display: none;
}

.ctx-tab .unity-toggle__input {
    margin-left: 0;
    margin-right: 0;
}

/* The visible tab caption is the Toggle's own text element — colour it directly (the default theme sets a
   colour on text elements, so an inherited colour on the toggle root would not win). */
.ctx-tab .unity-toggle__text {
    margin-left: 0;
    margin-right: 0;
    font-size: 14px;
    color: rgb(168, 156, 138);
}

.ctx-tab:checked {
    border-bottom-color: rgb(224, 178, 90);
}

.ctx-tab:checked .unity-toggle__text {
    color: rgb(241, 231, 214);
}

/* Filled state: fills the area below the tab row. Holds the three panes (one shown by ContextTabsView). */
.ctx-filled {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

/* A tab pane fills the filled-state region; only the active one is displayed (ContextTabsView toggles display). */
.ctx-pane {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* The Overview pane lays its discrete blocks out in a row (mockup .blocks). */
.ctx-pane--row {
    flex-direction: row;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
}

/* ---- discrete blocks (mockup .block) ---- */
.block {
    flex-direction: column;
    margin-right: 10px;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 13px;
    padding-right: 13px;
    background-color: rgba(255, 255, 255, 0.015);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(217, 164, 65, 0.12);
    border-right-color: rgba(217, 164, 65, 0.12);
    border-top-color: rgba(217, 164, 65, 0.12);
    border-bottom-color: rgba(217, 164, 65, 0.12);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.block--hex {
    width: 260px;
    flex-shrink: 0;
}

.block--district {
    width: 290px;
    flex-shrink: 0;
}

.block--prod {
    flex-grow: 1;
    min-width: 0;
    margin-right: 0;
}

/* Block header caption (mockup .bh). */
.block-h {
    font-size: 11px;
    letter-spacing: 2px;
    margin-bottom: 9px;
    color: rgb(125, 114, 100);
}

/* Block header with a trailing level chip (mockup .bh.row). */
.block-h-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 9px;
}

.block-h-cap {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgb(125, 114, 100);
}

.block-h-lvl {
    font-size: 12px;
    color: rgb(125, 114, 100);
}

/* Hex identity (icon + name) — top of the Гекс block (mockup .hexhead). */
.hexhead {
    flex-direction: row;
    align-items: center;
    margin-bottom: 11px;
}

.terrain-icon {
    width: 36px;
    height: 36px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(255, 255, 255, 0.10);
}

.ctx-title {
    font-size: 17px;
    color: rgb(241, 231, 214);
    -unity-font-style: bold;
}

/* Small sub-label inside a block (mockup .minilbl), e.g. "Ресурси". */
.minilbl {
    font-size: 11px;
    letter-spacing: 2px;
    margin-bottom: 7px;
    color: rgb(125, 114, 100);
}

/* ---- resource icons (icon-only) ---- */
/* The resources block is a wrapping row of resource icons. Each resource is ONE square icon TILE — no pill,
   no text label (icon-only): the same unified plate as .terrain-icon / .res-row-icon, differing only in size
   (bg 0.08 + 0.10 border + ~0.25 radius). The resource name is a hover tooltip, set in C# (HexInfoPanelView),
   not a visible label. The .chip class name is kept (C# pool / UXML preview reference it). */
.chips {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.chip {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    margin-bottom: 8px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.08);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(255, 255, 255, 0.10);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

/* ---- District name + key-value list (District scaffold, mockup .dname / .kv) ---- */
.dname {
    font-size: 17px;
    margin-bottom: 9px;
    color: rgb(241, 231, 214);
    -unity-font-style: bold;
}

.kv {
    flex-direction: column;
}

.kv-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(217, 164, 65, 0.10);
}

.kv-k {
    font-size: 14px;
    color: rgb(168, 156, 138);
}

.kv-v {
    font-size: 14px;
    color: rgb(241, 231, 214);
}

.kv-v--owner {
    color: rgb(224, 178, 90);
}

.kv-v--oper {
    color: rgb(111, 160, 91);
}

.kv-role {
    flex-direction: row;
    align-items: center;
}

.kv-role-sw {
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.kv-role-sw--owner {
    background-color: rgb(224, 178, 90);
}

.kv-role-sw--oper {
    background-color: rgb(111, 160, 91);
}

/* ---- labour line + production table (Production scaffold, mockup .laborline / .prodtable) ---- */
.laborline {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 11px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(255, 255, 255, 0.03);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(232, 169, 106, 0.30);
    border-right-color: rgba(232, 169, 106, 0.30);
    border-top-color: rgba(232, 169, 106, 0.30);
    border-bottom-color: rgba(232, 169, 106, 0.30);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.laborline-k {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(125, 114, 100);
}

.laborline-v {
    font-size: 13px;
    color: rgb(232, 169, 106);
}

.prodtable {
    flex-direction: column;
}

.prod-row {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    border-top-width: 1px;
    border-top-color: rgba(217, 164, 65, 0.10);
}

.prod-row--head {
    border-top-width: 0;
}

.prod-name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: 13px;
    color: rgb(241, 231, 214);
}

.prod-c {
    width: 62px;
    -unity-text-align: middle-right;
    font-size: 13px;
}

.prod-h {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(125, 114, 100);
}

.prod-c--city {
    color: rgb(169, 200, 221);
}

.prod-c--owner {
    color: rgb(240, 215, 154);
}

.prod-c--oper {
    color: rgb(191, 224, 168);
}

.scaffold-tag {
    font-size: 11px;
    margin-top: 7px;
    color: rgb(125, 114, 100);
    -unity-font-style: italic;
}

/* ============ CONTEXT empty state (nothing selected) ============ */
/* Intentionally blank — no hint text. The tab row above stays visible; this only fills the area below it. */
.ctx-empty-wrap {
    flex-grow: 1;
    min-height: 0;
}

/* ============ TOP BAR — thin empty strip ============
   Resources moved to the left panel (below). The top bar is now a thin full-width strip pinned to the top
   edge — a placeholder for future window-openers + system icons (GENERAL_UI_STYLE.md §4). No content yet;
   ResourceBarView reveals it in Gameplay together with the left panel. */
.top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 30px;
    background-color: rgb(24, 20, 16);
    border-bottom-width: 1px;
    border-bottom-color: rgba(217, 164, 65, 0.28);
}

/* ============ LEFT PANEL — resource list (GENERAL_UI_STYLE.md §4 — left edge) ============
   Permanent left-edge panel holding the two inventory pools (Місто / Мер) as a VERTICAL scroll list: one row
   per resource (icon + City value + Mayor value). Pinned down the left edge BETWEEN the thin top bar and the
   bottom panel — top/bottom track .top-bar height (30 + 1 border) and .bottom-panel height (280 + 2 border).
   The right edge floats, so it carries the gold rim. Rows are built at runtime by ResourceBarView. */
.left-panel {
    position: absolute;
    left: 0;
    top: 31px;
    bottom: 282px;
    width: 150px;
    flex-direction: column;
    background-color: rgb(24, 20, 16);
    border-right-width: 1px;
    border-right-color: rgba(217, 164, 65, 0.28);
}

/* Static header row (Місто / Мер) — aligns its two labels over the row value columns via a leading spacer
   the width of the row icon. Does NOT scroll (sits above the ScrollView). */
.res-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-top: 9px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(217, 164, 65, 0.14);
}

.res-head-spacer {
    width: 28px;
    margin-right: 8px;
    flex-shrink: 0;
}

.res-head-lbl {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.res-head-lbl--city {
    color: rgb(91, 139, 176);
}

.res-head-lbl--mayor {
    color: rgb(224, 178, 90);
}

/* The scrolling list fills the rest of the panel below the header. */
.res-list {
    flex-grow: 1;
}

/* One resource row: square icon tile + City value + Mayor value (the values share the width evenly). */
.res-row {
    flex-direction: row;
    align-items: center;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
}

/* Unified square icon plate (same family as .terrain-icon / resource chips). */
.res-row-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.08);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(255, 255, 255, 0.10);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.res-val {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 14px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.res-val--city {
    color: rgb(91, 139, 176);
}

.res-val--mayor {
    color: rgb(224, 178, 90);
}
